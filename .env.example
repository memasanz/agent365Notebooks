# Copy to .env for a new checkout; do not overwrite an existing .env.
# Fill settings as you reach each notebook, then restart its kernel.
# Never commit .env, secrets, tokens, or notebook outputs containing them.
#
# Telemetry-only walkthrough: 01 -> 02 -> 03c -> 04.
# Tool walkthrough: 01 -> 02 -> either 03a or 03b -> 04.

# 01: Existing Foundry project and Responses-compatible model deployment.
# FOUNDRY_MODEL is the deployment name, not necessarily the model name.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_MODEL=YOUR-DEPLOYMENT-NAME

# 02: Provisioning tenant and ordinary interactive provisioning app.
# The bootstrap script prints these values; no provisioning secret is needed.
ENTRA_TENANT_ID=
ENTRA_PROVISIONING_CLIENT_ID=
AGENT_BLUEPRINT_NAME=LearningAssistantBlueprint
AGENT_IDENTITY_NAME=LearningAssistantLocal

# Leave these blank for initial provisioning in 02.
# After provisioning, save the returned IDs here to reuse the same objects.
# Use the returned values, not names or IDs from another deployment.
ENTRA_BLUEPRINT_OBJECT_ID=
ENTRA_BLUEPRINT_CLIENT_ID=
ENTRA_AGENT_IDENTITY_OBJECT_ID=

# 03a or 03c (local development): short-lived credential on the blueprint.
# Paste the secret VALUE into .env only, in single quotes. Never use a secret ID.
A365_AUTH_MODE=client_secret
ENTRA_BLUEPRINT_CLIENT_SECRET=

# 03b or 03c (Azure host): instead set A365_AUTH_MODE=managed_identity.
# Attach a user-assigned managed identity and configure blueprint federation.
# Do not copy a blueprint secret to the Azure host.
AZURE_MANAGED_IDENTITY_CLIENT_ID=
# Principal/object ID for configuring federation and the 03b setup checks.
AZURE_MANAGED_IDENTITY_OBJECT_ID=

# 04: Export structured activity spans to Agent 365 and Foundry.
# Use the Application Insights resource linked to your Foundry project.
# For Agent 365 only, set A365_EXPORT_TO_FOUNDRY=false and leave the string blank.
A365_CAPTURE_CONTENT=false
A365_EXPORT_TO_FOUNDRY=true
APPLICATIONINSIGHTS_CONNECTION_STRING=

# 04 section 7: Name of the optional Foundry External Agent registration.
# Its telemetry ID is the child identity ID above, not this display name.
FOUNDRY_EXTERNAL_AGENT_NAME=LearningAssistantExternal

# 04: Only needed to select among multiple EXISTING child-agent sponsors.
# Leave blank when there is one sponsor; do not invent caller details.
A365_SPONSOR_USER_ID=

# 03a/03b only: optional Graph OBO and Blob tool configuration.
# Skip everything below for the 03c telemetry-only path.
# Blank client IDs fall back to ENTRA_PROVISIONING_CLIENT_ID.
# Additional setup permissions/consent are explained in the tool notebooks.
ENTRA_USER_CLIENT_ID=
ENTRA_SETUP_CLIENT_ID=
# Blank selects the setup user for the delegated Graph consent example.
ENTRA_USER_OBJECT_ID=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_SAMPLE_BLOB=agent-guide.txt

# Optional Graph lookup checks for 03a/03b; normally leave these blank.
# GRAPH_APP_ID defaults to Microsoft's well-known Graph application ID.
# Service principal and scope IDs are resolved by the setup cells.
GRAPH_APP_ID=
GRAPH_SERVICE_PRINCIPAL_ID=
GRAPH_USER_READ_SCOPE_ID=
